Views/Dashboard/Index.cshtml
cshtml
@model DashboardViewModel
<h2>Field Dashboard</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (User.IsInRole("Admin") || User.IsInRole("Agronomist"))
{
    <form asp-action="SeedTelemetry" method="post" class="mb-3">
        <button class="btn btn-secondary">Seed sample telemetry</button>
    </form>
}

<h4>Devices</h4>
<table class="table">
    <tr><th>Device</th><th>Field</th><th>Status</th><th>Last updated (UTC)</th><th></th></tr>
    @foreach (var d in Model.Devices)
    {
        <tr>
            <td>@d.DeviceId</td>
            <td>@d.FieldName</td>
            <td>@d.Status</td>
            <td>@d.LastUpdated</td>
            <td>
                <form asp-action="TriggerIrrigation" method="post">
                    <input type="hidden" name="deviceId" value="@d.DeviceId" />
                    <button class="btn btn-primary btn-sm">Trigger Irrigation</button>
                </form>
            </td>
        </tr>
    }
</table>

<h4>Latest telemetry</h4>
<table class="table table-striped">
    <tr><th>Device</th><th>Soil moisture %</th><th>Temp °C</th><th>Time (UTC)</th></tr>
    @foreach (var t in Model.Telemetry)
    {
        <tr><td>@t.DeviceId</td><td>@t.SoilMoisture</td><td>@t.Temperature</td><td>@t.ReadingTime</td></tr>
    }
</table>


